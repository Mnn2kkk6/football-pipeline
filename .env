# --- Data lake (SeaweedFS local, tương thích S3; để trống S3_ENDPOINT_URL nếu dùng AWS S3 thật) ---
S3_BUCKET=football-datalake
S3_ENDPOINT_URL=http://s3:8333
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=localsecret
AWS_DEFAULT_REGION=us-east-1

# --- Data warehouse (PostgreSQL) ---
PG_HOST=postgres
PG_PORT=5432
PG_DB=football
PG_USER=football
PG_PASSWORD=football

# --- Phạm vi dữ liệu (StatsBomb open-data). 43/3 = FIFA World Cup 2018 ---
COMPETITION_ID=43
SEASON_ID=3
PG_HOST_PORT=15432
